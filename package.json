{
  "name": "visual-bd",
  "productName": "Visual BD",
  "version": "0.1.0",
  "description": "Aplicación de escritorio para diseñar y revisar bases de datos visualmente",
  "main": "./out/main/index.js",
  "author": "visual-bd",
  "license": "MIT",
  "build": {
    "win": { "icon": "resources/icon.ico" },
    "mac": { "icon": "resources/icon.icns" },
    "linux": { "icon": "resources/icon.png" }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "test:e2e": "npm run build && node tests/e2e/ejecutar.cjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
